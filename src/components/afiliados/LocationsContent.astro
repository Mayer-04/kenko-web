---
import LocationIcon from "@assets/icons/locations/location.svg";
import PhoneIcon from "@assets/icons/locations/phone.svg";
import LocationsMap from "@components/afiliados/LocationsMap.astro";

export interface LocationInfo {
  city: string;
  name: string;
  address: string;
  phone: string;
  image: ImageMetadata;
  imageAlt: string;
  mapImage: string;
  mapAlt: string;
  tag?: string;
  schedule: string[];
  accent: string;
  coordinates: {
    x: number;
    y: number;
  };
}

interface Props {
  locations: LocationInfo[];
}

const { locations } = Astro.props;
---

<div
  class="space-y-8"
  id="locations-list"
  role="list"
  aria-label="Listado de puntos de atención"
>
  {
    locations.map((location) => (
      <article
        class="location-card group overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md"
        role="listitem"
        data-search={`${location.city} ${location.name} ${location.address}`.toLowerCase()}
        data-location-card
        tabindex="0"
      >
        <div class="grid gap-5 p-4 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1.1fr)_minmax(0,1.2fr)]">
          <div class="flex flex-col gap-4">
            <div class="relative overflow-hidden rounded-2xl border border-zinc-200 bg-zinc-100">
              <img
                src={location.image.src}
                alt={location.imageAlt}
                class="h-[230px] w-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />

              {location.tag && (
                <div class="absolute left-4 top-4">
                  <span class="inline-flex items-center gap-2 rounded-full bg-white/90 px-3 py-1 text-[11px] font-semibold tracking-[0.08em] text-primary backdrop-blur-sm">
                    <LocationIcon class="h-3.5 w-3.5 fill-current" aria-hidden="true" />
                    {location.tag}
                  </span>
                </div>
              )}
            </div>
          </div>

          <div class="flex flex-col justify-center">
            <h2 class="mb-4 font-display text-[clamp(1.8rem,2vw,2.5rem)] font-semibold tracking-tight text-content">
              {location.city}
            </h2>

            <ul class="space-y-4" aria-label={`${location.city} información de contacto`}>
              <li class="flex items-start gap-3">
                <LocationIcon class="mt-1 h-5 w-5 shrink-0 fill-primary" aria-hidden="true" />
                <div>
                  <p class="font-display text-sm font-semibold uppercase tracking-[0.04em] text-content/80">
                    {location.name}
                  </p>
                  <p class="mt-1 text-sm leading-6 text-content/70">{location.address}</p>
                </div>
              </li>

              <li class="flex items-start gap-3">
                <svg aria-hidden="true" viewBox="0 0 24 24" class="mt-1 h-5 w-5 shrink-0 fill-primary">
                  <path d="M12 2a10 10 0 1 0 10 10A10.01 10.01 0 0 0 12 2zm1 5h-2v6l5.25 3.15 1-1.73L13 12.5z"/>
                </svg>
                <div class="space-y-1">
                  {location.schedule.map((item) => (
                    <p class="text-sm leading-6 text-content/70">{item}</p>
                  ))}
                </div>
              </li>

              <li class="flex items-start gap-3">
                <PhoneIcon class="mt-1 h-5 w-5 shrink-0 fill-primary" aria-hidden="true" />
                <p class="text-sm leading-6 text-content/70">{location.phone}</p>
              </li>
            </ul>

            <div class="mt-6 flex flex-wrap gap-3">
              <button
                type="button"
                class="inline-flex cursor-pointer items-center justify-center rounded-lg bg-secondary px-5 py-2.5 text-sm font-semibold text-primary transition hover:bg-secondary/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
              >
                Agendar Cita
              </button>
            </div>
          </div>

          <div class="flex h-full min-h-[220px] w-full">
            <LocationsMap lat={location.coordinates.lat} lng={location.coordinates.lng} address={location.address} city={location.city} />
          </div>
        </div>
      </article>
    ))
  }
</div>

<script>
  const searchInput = document.getElementById("location-search");
  const cards = Array.from(document.querySelectorAll("[data-location-card]"));
  const status = document.getElementById("search-status");

  const updateLocations = () => {
    const query = (searchInput as HTMLInputElement | null)?.value.trim().toLowerCase() ?? "";
    let visible = 0;

    cards.forEach((card) => {
      const target = card as HTMLElement;
      const text = (target.dataset.search ?? target.textContent ?? "").toLowerCase();
      const isVisible = !query || text.includes(query);
      target.hidden = !isVisible;
      if (isVisible) visible += 1;
    });

    if (status) {
      status.textContent = query
        ? `${visible} sede${visible === 1 ? "" : "s"} encontrada${visible === 1 ? "" : "s"}`
        : `${cards.length} sedes disponibles`;
    }
  };

  searchInput?.addEventListener("input", updateLocations);
  updateLocations();
</script>
