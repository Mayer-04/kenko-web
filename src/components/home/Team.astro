---
const teamImage =
  "https://lh3.googleusercontent.com/aida-public/AB6AXuDqlXO4s9R73_U-nHueNSEuu6M9J64BhugU569Inq6mHQe-09sKmQr8668Q-Bf6wJOAmLZcsyzGrRu9Nhh2mQaxgqr92BKwwg1V1TqZqlqgjDXcCV3Hn40kY9iAxJ5SVnhRhave2ly8lADND7EsUqSA7bAULOGNiVmUK4OrPeUUpp9rX90tfseCv3bkuKM7xluPIBsu0aQYZZnQxo6193Q9dFgx9wPS6Uk4GfVvppBcYA3CY5UgDyMrAA";
---

<section
  class="bg-primary/5 py-16 sm:py-20 lg:py-24"
  aria-labelledby="equipo-title"
>
  <div
    class="mx-auto grid w-full max-w-[1280px] items-center gap-10 px-6 md:grid-cols-2 lg:gap-16 lg:px-8"
  >
    <div class="overflow-hidden rounded-2xl shadow-xl shadow-primary/15">
      <img
        alt="Equipo diverso de profesionales de salud en un centro médico"
        class="aspect-4/3 h-full w-full object-cover"
        decoding="async"
        loading="lazy"
        src={teamImage}
      />
    </div>

    <div class="md:px-4 lg:px-8">
      <h2
        id="equipo-title"
        class="font-display text-3xl font-bold tracking-tight text-primary sm:text-4xl"
      >
        Contamos con los mejores especialistas
      </h2>
      <p class="mt-6 max-w-xl font-body text-lg leading-8 text-content/75">
        Nuestro equipo médico está altamente cualificado y comprometido con tu
        bienestar. Brindamos una atención personalizada, apoyada en la mejor
        evidencia científica y tecnología de vanguardia.
      </p>
      <a
        class="mt-8 inline-flex min-h-12 items-center justify-center rounded-lg bg-secondary px-6 py-3 font-display font-semibold text-on-secondary transition hover:bg-secondary/90 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
        href="/nosotros/organigrama"
      >
        Conoce nuestro organigrama
      </a>
    </div>
  </div>
</section>
