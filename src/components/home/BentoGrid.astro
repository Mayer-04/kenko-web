---
import ArrowForward from "@assets/icons/home/arrow forward.svg";
import Case from "@assets/icons/home/case.svg";
import Emergency from "@assets/icons/home/emergency.svg";
import Location from "@assets/icons/home/location.svg";
import Question from "@assets/icons/home/question.svg";
import Route from "@assets/icons/home/route.svg";

const services = [
  {
    title: "Puntos de atención",
    description: "Encuentra la sede más cercana a ti en nuestra red nacional.",
    href: "/afiliados/puntos-de-atencion",
    Icon: Location,
    accent: true,
  },
  {
    title: "Clasificación de triajes",
    description: "Conoce cómo priorizamos la atención en urgencias.",
    href: "/afiliados/triage",
    Icon: Emergency,
    className: "lg:col-start-3 lg:row-start-1",
  },
  {
    title: "Preguntas frecuentes",
    description: "Resuelve tus dudas sobre trámites, afiliaciones y servicios.",
    href: "/afiliados/preguntas-frecuentes",
    Icon: Question,
    className: "lg:col-start-1 lg:row-start-2",
  },
];
---

<section
  class="bg-background py-16 sm:py-20 lg:py-24"
  aria-labelledby="servicios-title"
>
  <div class="mx-auto w-full max-w-[1280px] px-6 lg:px-8">
    <h2
      id="servicios-title"
      class="font-display text-3xl font-bold tracking-tight text-primary sm:text-4xl"
    >
      Servicios para ti
    </h2>

    <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3 lg:grid-rows-2">
      {
        services.map((service) => {
          const Icon = service.Icon;

          return (
            <a
              class:list={[
                "group flex min-h-52 flex-col justify-between rounded-2xl border border-content/10 p-6 transition duration-200 hover:-translate-y-0.5 hover:border-primary/45 hover:shadow-lg hover:shadow-primary/10 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary",
                service.accent ? "bg-accent" : "bg-white",
                service.className,
              ]}
              href={service.href}
            >
              <Icon
                aria-hidden="true"
                class:list={[
                  "size-8 transition-transform duration-200 group-hover:scale-110",
                  service.accent ? "fill-on-accent" : "fill-primary",
                ]}
                focusable="false"
              />
              <div class="mt-8">
                <h3
                  class:list={[
                    "font-display text-xl font-semibold tracking-tight",
                    service.accent ? "text-on-accent" : "text-content",
                  ]}
                >
                  {service.title}
                </h3>
                <p
                  class:list={[
                    "mt-2 font-body text-sm leading-6",
                    service.accent ? "text-on-accent/70" : "text-content/70",
                  ]}
                >
                  {service.description}
                </p>
              </div>
            </a>
          );
        })
      }

      <a
        class="group relative order-first flex min-h-80 flex-col justify-between overflow-hidden rounded-2xl bg-secondary p-7 text-on-secondary transition duration-200 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-secondary/25 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary md:col-span-2 lg:col-span-1 lg:col-start-2 lg:row-span-2 lg:row-start-1"
        href="/afiliados/rutas-integrales-de-atencion-en-salud"
      >
        <div
          class="absolute -right-20 -bottom-20 size-72 rounded-full bg-primary/15 blur-3xl"
          aria-hidden="true"
        >
        </div>
        <Route
          aria-hidden="true"
          class="relative size-10 fill-content"
          focusable="false"
        />
        <div class="relative mt-14">
          <h3
            class="font-display text-3xl font-bold tracking-tight text-balance"
          >
            Descubre nuestras rutas de atención
          </h3>
          <p class="mt-4 font-body leading-7 text-content/80">
            Programas especializados diseñados para acompañarte en cada etapa de
            tu vida y cuidar integralmente tu salud.
          </p>
        </div>
        <span
          class="relative mt-8 inline-flex size-12 items-center justify-center self-end rounded-full bg-background transition-transform duration-200 group-hover:translate-x-1"
        >
          <ArrowForward
            aria-hidden="true"
            class="size-6 fill-primary"
            focusable="false"
          />
        </span>
      </a>

      <article
        class="flex min-h-52 flex-col justify-between rounded-2xl border border-content/10 bg-accent p-6 lg:col-start-3 lg:row-start-2"
        aria-labelledby="trabaja-title"
      >
        <Case
          aria-hidden="true"
          class="size-8 fill-on-accent"
          focusable="false"
        />
        <div class="mt-8">
          <h3
            id="trabaja-title"
            class="font-display text-xl font-semibold tracking-tight text-on-accent"
          >
            Trabaja con nosotros
          </h3>
          <p class="mt-2 font-body text-sm leading-6 text-on-accent/70">
            Únete a nuestro equipo de profesionales de la salud.
          </p>
          <p class="mt-3 font-body text-sm font-semibold text-on-accent">
            Próximamente
          </p>
        </div>
      </article>
    </div>
  </div>
</section>
