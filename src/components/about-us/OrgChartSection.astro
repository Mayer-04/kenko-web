---
import OrgChart from "@components/about-us/OrgChart.astro";
---

<section
  class="relative overflow-hidden bg-about-secondary py-16 text-on-about-secondary sm:py-20 lg:py-24"
  aria-labelledby="organigrama-title"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,_rgba(24,24,27,0.05),_transparent_65%)]"
  >
  </div>
  <div class="relative mx-auto w-full max-w-[1280px] px-6 lg:px-8">
    <header class="max-w-3xl">
      <p
        class="font-body text-[11px] font-semibold tracking-[0.2em] text-on-about-secondary/60 uppercase"
      >
        Liderazgo — Quiénes somos
      </p>
      <h2
        id="organigrama-title"
        class="mt-4 font-display text-3xl font-bold tracking-tight sm:text-4xl"
      >
        Organigrama
      </h2>
      <p
        class="mt-3 max-w-2xl font-body text-sm leading-6 text-on-about-secondary/65"
      >
        Tres fundadores, un mismo nivel: dirección articulada para una atención
        cercana, humana e innovadora.
      </p>
    </header>

    <div class="relative mt-10">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute top-[76px] right-6 left-6 hidden h-px bg-on-about-secondary/12 lg:block"
      >
      </div>
      <OrgChart />
    </div>
  </div>
</section>
