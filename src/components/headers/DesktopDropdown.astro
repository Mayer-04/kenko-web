---
import ChevronDownIcon from "@assets/icons/chevron-down.svg";
import type {
  DropdownMeta,
  NavigationItem,
} from "@components/headers/navigation";

interface Props {
  id: string;
  label: string;
  meta: DropdownMeta;
  items: NavigationItem[];
}

const { id, label, meta, items } = Astro.props;
const triggerId = `${id}-trigger`;
const panelId = `${id}-panel`;
---

<div class="relative" data-dropdown data-dropdown-id={id}>
  <button
    id={triggerId}
    type="button"
    class="inline-flex min-h-10 cursor-pointer items-center gap-2 rounded-lg px-3.5 py-2 font-display text-[16px] font-semibold text-content transition hover:bg-primary/5 hover:text-primary focus-visible:bg-primary/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary data-[open=true]:bg-primary/5 data-[open=true]:text-primary lg:px-4 lg:text-[17px]"
    aria-expanded="false"
    aria-controls={panelId}
    data-dropdown-trigger
    data-open="false"
  >
    <span>{label}</span>
    <ChevronDownIcon
      class="size-4 shrink-0 text-content/70 transition-transform duration-[220ms] ease-[cubic-bezier(0.16,1,0.3,1)]"
      aria-hidden="true"
      focusable="false"
      data-dropdown-chevron
    />
  </button>

  <div
    id={panelId}
    class="absolute top-full left-0 z-50 mt-3 ml-2 w-[22rem] rounded-2xl border border-content/10 bg-background p-5 shadow-lg"
    role="region"
    aria-label={label}
    aria-hidden="true"
    inert
    data-dropdown-panel
    data-open="false"
  >
    <p class="font-body text-xs font-semibold tracking-wide text-content/60">
      {meta.title}
    </p>
    <div class="mt-2 h-px bg-content/10" aria-hidden="true"></div>
    <p class="mt-3 font-body text-sm leading-5 text-content/70">
      {meta.description}
    </p>

    <ul class="mt-5" aria-label={`Opciones de ${label}`}>
      {
        items.map((item) => (
          <li class="border-t border-content/10 first:border-t-0">
            <a
              href={item.href}
              class="flex min-h-11 cursor-pointer items-center rounded-lg px-2 py-2.5 font-body text-sm leading-5 font-medium text-content transition hover:bg-primary/5 hover:text-primary focus-visible:bg-primary/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>
