---
interface Props {
  variant?: "mobile" | "desktop";
  id?: string;
}

const { variant = "desktop", id } = Astro.props;

const baseClasses =
  "inline-flex items-center justify-center rounded-xl border-2 border-primary bg-background font-display font-semibold text-primary transition hover:bg-primary hover:text-on-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary disabled:cursor-not-allowed disabled:opacity-100";

const variantClasses =
  variant === "mobile"
    ? "min-h-12 w-full px-6 text-lg"
    : "min-h-11 w-auto px-6 text-base";
---

<button
  id={id}
  type="button"
  class={`${baseClasses} ${variantClasses}`}
  disabled
>
  Ingresa
</button>
