---
import Logo from "@assets/icons/logo-kenko.svg";
import DesktopDropdown from "@components/headers/DesktopDropdown.astro";
import IngresaButton from "@components/headers/IngresaButton.astro";
import {
  aboutItems,
  aboutMeta,
  affiliateItems,
  affiliateMeta,
} from "@components/headers/navigation";
---

<desktop-header class="hidden md:block" data-desktop-header>
  <header
    class="sticky top-0 z-50 flex min-h-21 w-full items-center bg-background/85 shadow-sm backdrop-blur-md"
    aria-label="Encabezado principal"
  >
    <div
      class="mx-auto flex min-h-21 w-full max-w-[1280px] items-center justify-between gap-6 px-6 lg:px-8"
    >
      <a
        href="/"
        class="shrink-0 rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary"
        aria-label="Kenko EPS, inicio"
      >
        <Logo
          class="w-32 text-primary lg:w-36"
          aria-hidden="true"
          focusable="false"
        />
      </a>

      <nav
        class="flex items-center"
        aria-label="Navegación principal"
        data-desktop-nav
      >
        <ul class="flex items-center gap-2 lg:gap-5">
          <li>
            <a
              href="/"
              class="inline-flex min-h-10 cursor-pointer items-center rounded-lg px-3.5 py-2 font-display text-[16px] font-semibold text-content transition hover:bg-primary/5 hover:text-primary focus-visible:bg-primary/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary lg:px-4 lg:text-[17px]"
            >
              Inicio
            </a>
          </li>
          <li>
            <DesktopDropdown
              id="afiliados-desktop"
              label="Afiliados"
              meta={affiliateMeta}
              items={affiliateItems}
            />
          </li>
          <li>
            <DesktopDropdown
              id="nosotros-desktop"
              label="Nosotros"
              meta={aboutMeta}
              items={aboutItems}
            />
          </li>
        </ul>
      </nav>

      <div class="shrink-0">
        <IngresaButton variant="desktop" />
      </div>
    </div>
  </header>
</desktop-header>

<style is:global>
  desktop-header [data-dropdown-panel] {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-0.375rem);
    transition:
      opacity 220ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 260ms cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s linear 260ms;
    visibility: hidden;
  }

  desktop-header [data-dropdown][data-open="true"] [data-dropdown-panel] {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
    transition:
      opacity 200ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 240ms cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s linear 0s;
    visibility: visible;
  }

  desktop-header [data-dropdown][data-open="true"] [data-dropdown-chevron] {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    desktop-header [data-dropdown-panel],
    desktop-header [data-dropdown-chevron] {
      transition-duration: 0ms !important;
    }
  }
</style>

<script>
  class DesktopHeader extends HTMLElement {
    private openId: string | null = null;
    private closeTimeout: number | null = null;
    private openTimeout: number | null = null;
    private boundDocumentClick: ((e: MouseEvent) => void) | null = null;
    private boundKeydown: ((e: KeyboardEvent) => void) | null = null;
    private isPointerDown = false;
    private pointerDownTimeout: number | null = null;

    connectedCallback() {
      if (this.dataset.ready === "true") return;
      this.dataset.ready = "true";

      const dropdowns = this.querySelectorAll<HTMLElement>("[data-dropdown]");
      if (dropdowns.length === 0) return;

      dropdowns.forEach((dropdown) => {
        const trigger = dropdown.querySelector<HTMLButtonElement>(
          "[data-dropdown-trigger]",
        );
        const panel = dropdown.querySelector<HTMLElement>(
          "[data-dropdown-panel]",
        );
        if (!trigger || !panel) return;

        // Track pointer to distinguish mouse focus from keyboard
        trigger.addEventListener("pointerdown", () => {
          this.isPointerDown = true;
          if (this.pointerDownTimeout !== null) {
            window.clearTimeout(this.pointerDownTimeout);
          }
          this.pointerDownTimeout = window.setTimeout(() => {
            this.isPointerDown = false;
          }, 300);
        });

        // Click / tap toggle
        trigger.addEventListener("click", () => {
          this.clearTimers();
          const isOpen = dropdown.dataset.open === "true";
          if (isOpen) {
            this.close(dropdown);
          } else {
            this.open(dropdown);
          }
        });

        // Hover
        dropdown.addEventListener("mouseenter", () => {
          this.clearTimers();
          this.openTimeout = window.setTimeout(() => this.open(dropdown), 90);
        });

        dropdown.addEventListener("mouseleave", () => {
          this.clearTimers();
          this.closeTimeout = window.setTimeout(
            () => this.close(dropdown),
            160,
          );
        });

        // Focus management
        trigger.addEventListener("focus", () => {
          if (this.isPointerDown) return;
          this.clearTimers();
          this.open(dropdown);
        });

        dropdown.addEventListener("focusin", () => {
          this.clearTimers();
        });

        dropdown.addEventListener("focusout", (event) => {
          const related = event.relatedTarget as Element | null;
          if (related && dropdown.contains(related)) return;
          // Delay to allow focus to move to panel links
          this.closeTimeout = window.setTimeout(() => {
            if (!dropdown.contains(document.activeElement)) {
              this.close(dropdown);
            }
          }, 120);
        });

        // Keyboard on trigger
        trigger.addEventListener("keydown", (event) => {
          if (event.key === "ArrowDown") {
            event.preventDefault();
            this.open(dropdown);
            const firstLink = panel.querySelector<HTMLAnchorElement>("a[href]");
            firstLink?.focus();
          } else if (
            event.key === "Enter" ||
            event.key === " " ||
            event.key === "Spacebar"
          ) {
            // Let click handle toggle, but prevent scroll on Space
            if (event.key === " " || event.key === "Spacebar") {
              event.preventDefault();
            }
          } else if (event.key === "Escape") {
            event.preventDefault();
            this.close(dropdown);
            trigger.focus();
          }
        });

        // Keyboard inside panel
        panel.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            event.preventDefault();
            this.close(dropdown);
            trigger.focus();
          }
        });
      });

      this.boundDocumentClick = (event: MouseEvent) => {
        const target = event.target as Element | null;
        if (!target) return;
        const isInside = target.closest("[data-dropdown]");
        if (!isInside) {
          this.closeAll();
        }
      };

      this.boundKeydown = (event: KeyboardEvent) => {
        if (event.key === "Escape" && this.openId) {
          this.closeAll();
          // Focus the trigger that was open
          const openDropdown = this.querySelector<HTMLElement>(
            `[data-dropdown-id="${this.openId}"]`,
          );
          const trigger = openDropdown?.querySelector<HTMLButtonElement>(
            "[data-dropdown-trigger]",
          );
          trigger?.focus();
        }
      };

      document.addEventListener("click", this.boundDocumentClick);
      document.addEventListener("keydown", this.boundKeydown);
    }

    disconnectedCallback() {
      if (this.boundDocumentClick) {
        document.removeEventListener("click", this.boundDocumentClick);
      }
      if (this.boundKeydown) {
        document.removeEventListener("keydown", this.boundKeydown);
      }
      this.clearTimers();
      if (this.pointerDownTimeout !== null) {
        window.clearTimeout(this.pointerDownTimeout);
        this.pointerDownTimeout = null;
      }
    }

    private clearTimers() {
      if (this.closeTimeout !== null) {
        window.clearTimeout(this.closeTimeout);
        this.closeTimeout = null;
      }
      if (this.openTimeout !== null) {
        window.clearTimeout(this.openTimeout);
        this.openTimeout = null;
      }
    }

    private open(dropdown: HTMLElement) {
      const id = dropdown.dataset.dropdownId;
      if (!id) return;

      // Close others
      this.querySelectorAll<HTMLElement>("[data-dropdown]").forEach((other) => {
        if (other !== dropdown) this.close(other);
      });

      const trigger = dropdown.querySelector<HTMLButtonElement>(
        "[data-dropdown-trigger]",
      );
      const panel = dropdown.querySelector<HTMLElement>(
        "[data-dropdown-panel]",
      );
      if (!trigger || !panel) return;

      dropdown.dataset.open = "true";
      trigger.dataset.open = "true";
      trigger.setAttribute("aria-expanded", "true");
      panel.dataset.open = "true";
      panel.setAttribute("aria-hidden", "false");
      panel.removeAttribute("inert");
      this.openId = id;
    }

    private close(dropdown: HTMLElement) {
      const trigger = dropdown.querySelector<HTMLButtonElement>(
        "[data-dropdown-trigger]",
      );
      const panel = dropdown.querySelector<HTMLElement>(
        "[data-dropdown-panel]",
      );
      if (!trigger || !panel) return;

      dropdown.dataset.open = "false";
      trigger.dataset.open = "false";
      trigger.setAttribute("aria-expanded", "false");
      panel.dataset.open = "false";
      panel.setAttribute("aria-hidden", "true");
      panel.setAttribute("inert", "");
      if (this.openId === dropdown.dataset.dropdownId) {
        this.openId = null;
      }
    }

    private closeAll() {
      this.clearTimers();
      this.querySelectorAll<HTMLElement>("[data-dropdown]").forEach((d) =>
        this.close(d),
      );
    }
  }

  customElements.define("desktop-header", DesktopHeader);
</script>
