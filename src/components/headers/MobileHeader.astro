---
import Logo from "@assets/icons/logo-kenko.svg";
import MobileMenuToggle from "@components/headers/MobileMenuToggle.astro";
import MobileNavigation from "@components/headers/MobileNavigation.astro";
---

<mobile-header class="block md:hidden" data-menu-open="false">
  <header
    class="sticky top-0 z-50 flex min-h-21 w-full items-center justify-between bg-background/85 px-6 py-3 shadow-sm backdrop-blur-md"
    aria-label="Encabezado principal"
  >
    <a
      class="rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary"
      href="/"
      aria-label="Kenko EPS, inicio"
    >
      <Logo class="w-28 text-primary" aria-hidden="true" focusable="false" />
    </a>
    <MobileMenuToggle />
  </header>
  <MobileNavigation />
</mobile-header>

<style is:global>
  mobile-header [data-mobile-navigation] {
    display: block;
    max-height: 0;
    margin-block: 0;
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
    transform: translateY(-0.5rem);
    transition:
      max-height 280ms cubic-bezier(0.22, 1, 0.36, 1),
      margin 280ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 180ms ease,
      transform 280ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 280ms;
    visibility: hidden;
  }

  mobile-header[data-menu-open="true"] [data-mobile-navigation] {
    max-height: 40rem;
    margin-block: 0.75rem 1rem;
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
    transition:
      max-height 320ms cubic-bezier(0.22, 1, 0.36, 1),
      margin 320ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 220ms ease,
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0s;
    visibility: visible;
  }

  mobile-header:not(:defined) [data-mobile-navigation] {
    max-height: none;
    margin-block: 0.75rem 1rem;
    opacity: 1;
    overflow: visible;
    pointer-events: auto;
    transform: none;
    transition: none;
    visibility: visible;
  }

  mobile-header [data-navigation-submenu] {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
    transition:
      max-height 240ms cubic-bezier(0.22, 1, 0.36, 1),
      margin 240ms ease,
      opacity 160ms ease,
      padding 240ms ease,
      visibility 0s linear 240ms;
    visibility: hidden;
  }

  mobile-header
    [data-navigation-section][data-expanded="true"]
    [data-navigation-submenu] {
    max-height: 40rem;
    margin-block: 0.5rem;
    opacity: 1;
    padding-block: 0.5rem;
    pointer-events: auto;
    transition:
      max-height 300ms cubic-bezier(0.22, 1, 0.36, 1),
      margin 260ms ease,
      opacity 180ms ease,
      padding 260ms ease,
      visibility 0s linear 0s;
    visibility: visible;
  }

  mobile-header:not(:defined) [data-navigation-submenu] {
    max-height: none;
    opacity: 1;
    overflow: visible;
    padding-block: 0.5rem;
    pointer-events: auto;
    transition: none;
    visibility: visible;
  }

  mobile-header[data-menu-open="true"] [data-menu-control-icon] {
    background-color: var(--primary);
    border-color: var(--primary);
    color: var(--on-primary);
  }

  mobile-header [data-navigation-section][data-expanded="true"] > button {
    color: var(--primary);
  }

  @media (prefers-reduced-motion: reduce) {
    mobile-header * {
      scroll-behavior: auto;
      transition-duration: 0ms !important;
    }
  }
</style>

<script>
  class MobileHeader extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready === "true") {
        return;
      }

      const menuToggle = this.querySelector<HTMLButtonElement>(
        "[data-mobile-menu-toggle]",
      );
      const navigation = this.querySelector<HTMLElement>(
        "[data-mobile-navigation]",
      );

      if (!menuToggle || !navigation) {
        return;
      }

      this.dataset.ready = "true";
      this.setMenuOpen(false);
      this.querySelectorAll<HTMLElement>("[data-navigation-section]").forEach(
        (section) => {
          this.setSectionExpanded(section, false);
        },
      );

      menuToggle.addEventListener("click", () => {
        this.setMenuOpen(navigation.getAttribute("aria-hidden") === "true");
      });

      this.querySelectorAll<HTMLButtonElement>(
        "[data-navigation-section-trigger]",
      ).forEach((button) => {
        button.addEventListener("click", () => {
          const section = button.closest<HTMLElement>(
            "[data-navigation-section]",
          );

          if (!section) {
            return;
          }

          const willExpand = section.dataset.expanded !== "true";
          this.querySelectorAll<HTMLElement>(
            "[data-navigation-section]",
          ).forEach((item) => {
            this.setSectionExpanded(item, item === section && willExpand);
          });
        });
      });

      this.addEventListener("keydown", (event) => {
        if (
          event.key === "Escape" &&
          navigation.getAttribute("aria-hidden") !== "true"
        ) {
          this.setMenuOpen(false);
          menuToggle.focus();
        }
      });
    }

    private setMenuOpen(isOpen: boolean) {
      const menuToggle = this.querySelector<HTMLButtonElement>(
        "[data-mobile-menu-toggle]",
      );
      const navigation = this.querySelector<HTMLElement>(
        "[data-mobile-navigation]",
      );
      const closeLabel = this.querySelector<HTMLElement>(
        "[data-menu-close-label]",
      );
      const openIcon = this.querySelector<SVGElement>("[data-menu-open-icon]");
      const closeIcon = this.querySelector<SVGElement>(
        "[data-menu-close-icon]",
      );

      if (
        !menuToggle ||
        !navigation ||
        !closeLabel ||
        !openIcon ||
        !closeIcon
      ) {
        return;
      }

      if (isOpen) {
        this.querySelectorAll<HTMLElement>("[data-navigation-section]").forEach(
          (section) => {
            this.setSectionExpanded(section, false);
          },
        );
      }

      this.dataset.menuOpen = String(isOpen);
      navigation.setAttribute("aria-hidden", String(!isOpen));
      navigation.toggleAttribute("inert", !isOpen);
      menuToggle.setAttribute("aria-expanded", String(isOpen));
      menuToggle.setAttribute(
        "aria-label",
        isOpen ? "Cerrar menú" : "Abrir menú",
      );
      closeLabel.hidden = !isOpen;
      this.setElementHidden(openIcon, isOpen);
      this.setElementHidden(closeIcon, !isOpen);
    }

    private setSectionExpanded(section: HTMLElement, isExpanded: boolean) {
      const trigger = section.querySelector<HTMLButtonElement>(
        "[data-navigation-section-trigger]",
      );
      const submenu = section.querySelector<HTMLElement>(
        "[data-navigation-submenu]",
      );
      const rightChevron = section.querySelector<SVGElement>(
        "[data-chevron-right]",
      );
      const downChevron = section.querySelector<SVGElement>(
        "[data-chevron-down]",
      );

      if (!trigger || !submenu || !rightChevron || !downChevron) {
        return;
      }

      section.dataset.expanded = String(isExpanded);
      trigger.setAttribute("aria-expanded", String(isExpanded));
      submenu.setAttribute("aria-hidden", String(!isExpanded));
      submenu.toggleAttribute("inert", !isExpanded);
      this.setElementHidden(rightChevron, isExpanded);
      this.setElementHidden(downChevron, !isExpanded);
    }

    private setElementHidden(element: Element, isHidden: boolean) {
      element.toggleAttribute("hidden", isHidden);
    }
  }

  customElements.define("mobile-header", MobileHeader);
</script>
