---
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import virtualAccessImage from "@assets/images/Virtual-access/cirugia.webp";
---

<Layout title="Ingreso virtual - Kenko EPS" description="Portal de acceso para pacientes de Kenko EPS.">
  <div class="login-page">
    <div class="login-card">
      <section class="login-form-panel">
        <div class="brand-block">
          <img
            alt="Kenko Health Logo"
            class="brand-logo"
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuC3aL1vyPgWD7_rfQTs1rrl_FQs2m_Y4-GVPR8_JqhmU-8HIkC4laQ2WfLVgdMyLlQ6UZfFMu-gODfJt_PTNQ1pjpvLrmHwklkkVQsW86L1fkLa2hjMEmFGBUx2vc57d8s_EzqNsF0svPuRCkealEm38pBzN4cPudufzjhjGxTpXzCgCL6oH86qlVCxTfU8gwOcsWk0ApdTRpf5LizoY5SdD--Cs22ozcrpD2CV65b-4ZuGrZ4e1Wh7K73RLOgiyzlo-Q"
          />
          <h1>Bienvenido</h1>
          <p>Inicie sesión en su portal para pacientes.</p>
        </div>

        <form class="login-form">
          <div class="field-group">
            <label for="username">Nombre de usuario o identificación</label>
            <div class="input-wrap">
              <svg class="field-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4Zm0 2c-4.42 0-8 2.24-8 5v1h16v-1c0-2.76-3.58-5-8-5Z"/>
              </svg>
              <input
                id="username"
                type="text"
                placeholder="Ingrese su identificación"
              />
            </div>
          </div>

          <div class="field-group">
            <label for="password">Contraseña</label>
            <div class="input-wrap">
              <svg class="field-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M17 9h-1V7a4 4 0 1 0-8 0v2H7a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2Zm-6 6.73V16a1 1 0 0 1 2 0v-.27a2 2 0 1 1-2 0ZM10 9V7a2 2 0 0 1 4 0v2Z"/>
              </svg>
              <input
                id="password"
                type="password"
                placeholder="Ingrese su contraseña"
              />
            </div>

            <div class="forgot-link-row">
              <a href="#">¿Olvidó su contraseña?</a>
            </div>
          </div>

          <button type="button" class="submit-button">
            Iniciar sesión
          </button>
        </form>

        <div class="signup-callout">
          ¿No tiene una cuenta? <a href="#">Crear una cuenta</a>
        </div>
      </section>

      <aside class="hero-panel">
        <Image
          src={virtualAccessImage}
          alt="Profesional de salud atendiendo a un paciente en una clínica moderna"
          class="hero-panel-image"
        />
        <div class="hero-overlay"></div>
        <div class="hero-copy">
          <h2>Su salud, nuestra prioridad.</h2>
          <p>
            Acceda a sus resultados, agende citas y comuníquese con sus especialistas
            desde un solo lugar.
          </p>
        </div>
      </aside>
    </div>
  </div>

  <style is:global>
    @import url("https://fonts.googleapis.com/css2?family=Figtree:wght@400;600;700&family=Manrope:wght@400;500;600&display=swap");

    .field-icon {
      position: absolute;
      left: 0.75rem;
      width: 1.2rem;
      height: 1.2rem;
      fill: #72777e;
      pointer-events: none;
      z-index: 1;
    }

    .login-page {
      min-height: calc(100vh - 96px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem 1rem;
      background: #f9fafb;
      color: #1b1b1e;
      font-family: "Manrope", sans-serif;
    }

    .login-card {
      width: min(100%, 1200px);
      display: grid;
      grid-template-columns: 1fr 1fr;
      background: #ffffff;
      border-radius: 1rem;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(24, 24, 27, 0.05);
    }

    .login-form-panel {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 2rem;
      background: #fbf8fc;
    }

    .brand-block {
      margin-bottom: 2.5rem;
    }

    .brand-logo {
      width: auto;
      height: 4rem;
      margin-bottom: 1.5rem;
    }

    .brand-block h1 {
      margin: 0 0 0.5rem;
      font-family: "Figtree", sans-serif;
      font-size: clamp(2rem, 4vw, 2.5rem);
      line-height: 1.2;
      font-weight: 700;
      color: #013252;
    }

    .brand-block p {
      margin: 0;
      font-size: 1rem;
      color: #42474e;
    }

    .login-form {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .field-group {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .field-group label {
      font-size: 0.875rem;
      line-height: 1.25rem;
      font-weight: 600;
      color: #1b1b1e;
    }

    .input-wrap {
      position: relative;
      display: flex;
      align-items: center;
    }

    .input-wrap input {
      width: 100%;
      border: 1px solid #c2c7ce;
      border-radius: 0.75rem;
      background: #f6f2f7;
      color: #1b1b1e;
      padding: 0.8rem 0.875rem 0.8rem 2.8rem;
      font: inherit;
      outline: none;
      transition: box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .input-wrap input::placeholder {
      color: #72777e;
    }

    .input-wrap input:focus {
      border-color: transparent;
      box-shadow: 0 0 0 2px rgba(1, 50, 82, 0.2);
    }

    .forgot-link-row {
      display: flex;
      justify-content: flex-end;
      margin-top: 0.5rem;
    }

    .forgot-link-row a,
    .signup-callout a {
      color: #013252;
      text-decoration: none;
      font-weight: 600;
      transition: color 0.2s ease;
    }

    .forgot-link-row a:hover,
    .signup-callout a:hover {
      color: #21496a;
    }

    .submit-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      width: 100%;
      border: none;
      background: #21496a;
      color: #ffffff;
      border-radius: 0.75rem;
      padding: 0.9rem 1rem;
      font-weight: 700;
      font-size: 0.95rem;
      cursor: pointer;
      transition: background 0.2s ease;
    }

    .submit-button:hover {
      background: #013252;
    }

    .signup-callout {
      margin-top: 1.75rem;
      text-align: center;
      color: #42474e;
    }

    .hero-panel {
      position: relative;
      min-height: 600px;
      background: #a5caf1;
      display: block;
    }

    .hero-panel-image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .hero-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(1, 50, 82, 0.8), transparent);
    }

    .hero-copy {
      position: absolute;
      inset: auto 2rem 2rem 2rem;
      color: #ffffff;
      z-index: 1;
    }

    .hero-copy h2 {
      margin: 0 0 0.75rem;
      font-family: "Figtree", sans-serif;
      font-size: clamp(1.6rem, 2vw, 2rem);
      font-weight: 700;
      line-height: 1.2;
    }

    .hero-copy p {
      margin: 0;
      font-size: 1rem;
      line-height: 1.6;
      opacity: 0.9;
    }

    @media (max-width: 768px) {
      .login-card {
        grid-template-columns: 1fr;
      }

      .hero-panel {
        display: none;
      }

      .login-form-panel {
        padding: 1.5rem 1rem;
      }
    }
  </style>
</Layout>
