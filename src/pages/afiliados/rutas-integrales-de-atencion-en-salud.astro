---
import Layout from "@layouts/Layout.astro";
import Dropdown from "@components/afiliados/Dropdown.astro";
import RiasRoutePanel from "@components/afiliados/RiasRoutePanel.astro";
import ChevronIcon from "../../assets/icons/rias/chevron_right.svg";
import doctorWorkingImage from "../../assets/scrapings-content/Savia-salud Afiliados/imagenes/doctor-haciendo-su-trabajo-oficina-pediatria.jpg";
import doctorReviewingImage from "../../assets/scrapings-content/Savia-salud Afiliados/imagenes/joven-doctora-usando-estetoscopio-escuchar-latidos-corazon-paciente-toma-doctora-dandole-chequeo-paciente-varon.jpg";

const markdownModule = await import(
  "../../assets/scrapings-content/Savia-salud Afiliados/afiliados-savia.md?raw"
);
const rawMarkdown = typeof markdownModule.default === "string" ? markdownModule.default : String(markdownModule);

const whatAreRias =
  "Son el conjunto de acciones de promoción de la salud y prevención de la enfermedad de carácter colectivo e individual; de búsqueda activa para diagnóstico precoz y tratamiento oportuno; de suministro de medicamentos, insumos y dispositivos médicos; de hospitalización y cirugía; de rehabilitación y cuidados paliativos; que requiere un paciente que padece una patología específica, un síndrome o una condición de salud; que deben ser ofrecidas de manera integral, oportuna y completa; por un conjunto de prestadores de servicios organizados como una red integrada; que tiene como objetivo mantenerlo sano y satisfecho, diagnosticarlo rápidamente, recuperar su salud, rehabilitarlo o mantener controlada su enfermedad y reducir el daño, para que pueda tener una vida productiva e independiente hasta donde sea posible.";

const constitutionItems = [
  {
    title: "Ruta integral de atención para la promoción y mantenimiento de la salud",
    text:
      "Dirigida a promover la salud, prevenir el riesgo, prevenir la enfermedad y generar cultura del cuidado de la salud en las personas, familias y comunidades; incluye valoración integral, detección temprana, protección específica y educación para la salud.",
  },
  {
    title: "Rutas integrales de atención para grupos de riesgo",
    text:
      "Intervenciones individuales y colectivas dirigidas a la identificación oportuna de factores de riesgo y su intervención, ya sea para evitar la aparición de una condición específica en salud o para realizar un diagnóstico y una derivación oportuna para el tratamiento.",
  },
  {
    title: "Rutas integrales de atención específica para eventos",
    text:
      "Intervenciones individuales y colectivas dirigidas principalmente al diagnóstico oportuno, tratamiento, rehabilitación y paliación de los eventos o condiciones específicas de salud priorizadas.",
  },
];

const routeData = [
  {
    id: "cancer-de-mama",
    label: "Ruta Cáncer de Mama",
    title: "Ruta Cáncer de Mama",
    description:
      "Realizamos jornadas de mamografías por toda Antioquia, con acompañamiento especial y transporte. En algunas jornadas se ofrecen servicios de citología para detectar a tiempo el cáncer de mama y el cáncer de cuello uterino.",
    interventions: [
      "Jornadas de mamografías por toda Antioquia.",
      "Atención especializada, centrada e integral.",
      "Sin necesidad de autorizaciones previas.",
      "Articulación con instituciones y hospitales de I nivel.",
    ],
    note:
      "Ningún usuario requiere autorizaciones para iniciar el tratamiento y la atención se articula con el sistema de salud regional.",
