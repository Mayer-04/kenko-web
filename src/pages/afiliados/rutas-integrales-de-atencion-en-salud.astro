  {
    id: "hemofilia",
    label: "Ruta Hemofilia",
    title: "Ruta Hemofilia",
    description:
      "La ruta de Hemofilia ofrece atención ambulatoria, domiciliaria, urgencias, apoyo diagnóstico y terapéutico, laboratorio, atención de eventos de sangrado y servicio farmacéutico.",
    interventions: [
      "Atención ambulatoria y domiciliaria.",
