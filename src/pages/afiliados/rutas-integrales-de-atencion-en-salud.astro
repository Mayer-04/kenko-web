const programs = [
  {
    title: "Programa de Cáncer infantil",
    description:
      "El ciclo de atención incluye diagnóstico, tratamiento, seguimiento, rehabilitación, metástasis y paliación. Además, ofrece laboratorio clínico, patología, medicina nuclear, apoyo diagnóstico, quimioterapia, radioterapia, entrega de medicamentos, urgencias, hospitalización, rehabilitación oncológica, transplante de médula ósea y procedimientos quirúrgicos e intervencionistas.",
  },
  {
    title: "Programa de Rehabilitación por Consumo de Sustancias",
    description:
      "Acompañamos a personas con consumo problemático de sustancias con un proceso integral de valoración, tratamiento, seguimiento y reinserción social. Se trabaja con intervenciones terapéuticas, apoyo psicológico, orientación familiar y actividades de recuperación sostenible para reducir recaídas y fortalecer la salud mental.",
  },
  {
    title: "Programa de Atención Integral para la Mujer y la Familia",
    description:
      "Incluye orientación en salud sexual y reproductiva, prevención, seguimiento prenatal y postnatal, apoyo psicosocial, educación en autocuidado y promoción de la salud familiar. Su enfoque es prevenir complicaciones, fortalecer el vínculo familiar y mejorar la calidad de vida de la madre, el recién nacido y la familia.",
  },
];
---

<Layout title="Rutas integrales de atención en salud - Kenko EPS" description="Conoce las rutas integrales de atención en salud, sus componentes, objetivos y programas de acompañamiento para la población afiliada.">
  <main class="mx-auto max-w-6xl px-4 py-12 md:px-8 lg:px-12">
    <header class="mb-12 text-center">
      <h1 class="font-display text-4xl font-bold tracking-[-0.04em] text-primary md:text-5xl">
        Rutas Integrales de Atención en Salud
      </h1>
    </header>

    <section class="mb-14 grid gap-8 md:grid-cols-12 md:items-center">
      <div class="md:col-span-7">
        <h2 class="mb-4 font-display text-3xl font-bold tracking-[-0.04em] text-primary md:text-4xl">
          ¿Qué son?
        </h2>
        <p class="mb-4 font-body text-base leading-7 text-content/80 md:text-lg">
          {whatAreRias}
        </p>
      </div>

      <div class="md:col-span-5">
        <div class="overflow-hidden rounded-[20px] border border-content/10 bg-background shadow-[0_12px_30px_rgba(24,24,27,0.08)]">
          <img
            src={doctorWorkingImage.src}
            alt="Doctor realizando trabajo en una oficina de pediatría"
            class="h-72 w-full object-cover md:h-80"
          />
        </div>
      </div>
    </section>

    <section class="mb-14 grid gap-8 md:grid-cols-12 md:items-center">
      <div class="md:order-2 md:col-span-5">
        <div class="overflow-hidden rounded-[20px] border border-content/10 bg-background shadow-[0_12px_30px_rgba(24,24,27,0.08)]">
          <img
            src={doctorReviewingImage.src}
            alt="Doctora revisando el corazón de un paciente con un estetoscopio"
            class="h-72 w-full object-cover md:h-80"
          />
        </div>
      </div>

      <div class="md:order-1 md:col-span-7">
        <h2 class="mb-4 font-display text-3xl font-bold tracking-[-0.04em] text-primary md:text-4xl">
          ¿Cómo están constituidas?
        </h2>
        <ul class="list-disc space-y-3 pl-6 font-body text-base leading-7 text-content/80 md:text-lg">
          {
            constitutionItems.map((item) => (
              <li>
                <strong class="font-semibold text-content">{item.title}:</strong> {item.text}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="mb-14">
      <h2 class="mb-5 font-display text-3xl font-bold tracking-[-0.04em] text-primary md:text-4xl">
        ¿Cuáles son sus objetivos?
      </h2>
      <ul class="list-disc space-y-3 pl-6 font-body text-base leading-7 text-content/80 md:text-lg">
        <li>Población sana.</li>
        <li>Usuario controlado.</li>
        <li>Reducir prevalencia.</li>
        <li>Reducir incidencia.</li>
        <li>Reducir eventos adversos.</li>
        <li>Sin PQRS.</li>
        <li>Sin tutelas.</li>
      </ul>
    </section>

    <section class="mb-14">
      <h2 class="mb-5 font-display text-3xl font-bold tracking-[-0.04em] text-primary md:text-4xl">
        Panel de rutas
      </h2>
      <RiasRoutePanel routes={routeData} defaultRouteId="cancer-de-mama" />
    </section>

    <section>
      <h2 class="mb-5 font-display text-3xl font-bold tracking-[-0.04em] text-primary md:text-4xl">
        Programas de Atención en Salud
      </h2>

      <div class="space-y-4">
        {
          programs.map((program, index) => (
            <Dropdown
              id={`programa-${index}`}
              title={program.title}
              chevronIcon={ChevronIcon}
              defaultOpen={index === 1}
            >
              <div class="space-y-3 font-body text-base leading-7 text-content/80 md:text-lg">
                <p>{program.description}</p>
              </div>
            </Dropdown>
          ))
        }
      </div>
    </section>
  </main>
</Layout>
