---

<Layout title={title} description={description}>
  <section class="border-b border-zinc-200 bg-white">
    <div class="mx-auto max-w-[1280px] px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
      <div class="max-w-2xl">
        <span
          class="mb-4 inline-flex items-center gap-2 rounded-full bg-primary/5 px-3 py-1.5 text-xs font-semibold tracking-[0.14em] text-primary uppercase"
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            class="h-3.5 w-3.5 fill-current"
          >
            <path
              d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z"
            ></path>
          </svg>
          Nuestra red
        </span>
        <h1
          class="font-display text-[clamp(2.4rem,4vw,4rem)] font-semibold tracking-tight text-content"
        >
          Puntos de Atención
        </h1>
        <p class="mt-4 max-w-xl text-lg leading-8 text-content/70">
          Encuentra el centro médico Kenko más cercano a ti. Ofrecemos
          instalaciones modernas y atención integral en las principales ciudades
          de Colombia.
        </p>

        <div class="mt-8 flex flex-col gap-4 md:flex-row">
          <label
            class="relative block w-full md:max-w-md"
            for="location-search"
          >
            <span class="sr-only">Buscar por ciudad o sede</span>
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              class="pointer-events-none absolute top-1/2 left-4 h-5 w-5 -translate-y-1/2 fill-zinc-400"
            >
              <path
                d="M10 2a8 8 0 0 1 6.32 13.69l4.39 4.39 1.41-1.41-4.39-4.39A8 8 0 1 1 10 2zm0 2a6 6 0 1 0 6 6 6 6 0 0 0-6-6z"
              ></path>
            </svg>
            <input
              id="location-search"
              type="search"
              placeholder="Buscar por ciudad o sede..."
              aria-label="Buscar por ciudad o sede"
              class="h-12 w-full rounded-xl border border-zinc-200 bg-zinc-50 pr-4 pl-11 text-base text-content placeholder:text-content/50 focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none"
            />
          </label>
        </div>

        <p
          id="search-status"
          class="mt-3 text-sm text-content/60"
          aria-live="polite"
        >
          {locations.length} sedes disponibles
        </p>
      </div>
    </div>
  </section>

  <section aria-label="Resultados de puntos de atención" class="bg-background">
    <div class="mx-auto max-w-[1280px] px-4 py-12 sm:px-6 lg:px-8">
      <LocationsContent locations={locations} />
    </div>
  </section>
</Layout>
