{
  "name": "kenko-web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "bun run build && playwright test",
    "test:e2e:ui": "bun run build && playwright test --ui",
    "test:e2e:debug": "bun run build && playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:all": "bun run test:unit && bun run test:e2e",
    "lint": "eslint \"src/**/*.{js,ts,tsx,astro}\" \"tests/**/*.{js,ts,tsx}\" \"playwright.config.ts\"",
    "lint:fix": "eslint \"src/**/*.{js,ts,tsx,astro}\" \"tests/**/*.{js,ts,tsx}\" \"playwright.config.ts\" --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@astrojs/react": "6.0.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/ui": "4.1.11",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.1.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
